# vim: set sts=2 sw=2 tw=99 et ft=python:
# pylint: disable=all

import os

builder.SetBuildFolder('libpcre2')

def prep_pcre2(builder):
  builder.AddFolder('src')
  builder.AddFolder('headers')

  pcre2_header = builder.AddCopy(
    os.path.join(builder.currentSourcePath, 'pcre2', 'src', 'pcre2.h.generic'),
    os.path.join('headers', 'pcre2.h')
  )
  pcre2_chartables = builder.AddCopy(
    os.path.join(builder.currentSourcePath, 'pcre2', 'src', 'pcre2_chartables.c.dist'),
    os.path.join('src', 'pcre2_chartables.c')
  )
  return {
    'pcre2_header': pcre2_header,
    'pcre2_chartables': pcre2_chartables
  }

pcre2_generated = builder.CallBuilder(prep_pcre2)

rvalue = {}

for cxx in builder.targets:
  binary = SM.StaticLibrary(builder, cxx, 'pcre2')
  binary.compiler.includes += [
    os.path.join(builder.buildPath, 'libpcre2', 'headers'),
    os.path.join(builder.currentSourcePath, 'pcre2', 'src'),
    os.path.join(builder.currentSourcePath, 'pcre2_config', binary.compiler.target.platform)
  ]
  binary.compiler.sourcedeps += [pcre2_generated['pcre2_header']]

  binary.compiler.defines += ['PCRE2_CODE_UNIT_WIDTH=8', 'HAVE_CONFIG_H']
  if builder.options.debug == '1':
    binary.compiler.defines += ['PCRE2_DEBUG']

  binary.sources += [
    'pcre2/src/pcre2_auto_possess.c',
    'pcre2/src/pcre2_chkdint.c',
    pcre2_generated['pcre2_chartables'],
    'pcre2/src/pcre2_compile.c',
    'pcre2/src/pcre2_compile_cgroup.c',
    'pcre2/src/pcre2_compile_class.c',
    'pcre2/src/pcre2_config.c',
    'pcre2/src/pcre2_context.c',
    'pcre2/src/pcre2_convert.c',
    'pcre2/src/pcre2_dfa_match.c',
    'pcre2/src/pcre2_error.c',
    'pcre2/src/pcre2_extuni.c',
    'pcre2/src/pcre2_find_bracket.c',
    'pcre2/src/pcre2_jit_compile.c',
    'pcre2/src/pcre2_maketables.c',
    'pcre2/src/pcre2_match.c',
    'pcre2/src/pcre2_match_data.c',
    'pcre2/src/pcre2_match_next.c',
    'pcre2/src/pcre2_newline.c',
    'pcre2/src/pcre2_ord2utf.c',
    'pcre2/src/pcre2_pattern_info.c',
    'pcre2/src/pcre2_script_run.c',
    'pcre2/src/pcre2_serialize.c',
    'pcre2/src/pcre2_string_utils.c',
    'pcre2/src/pcre2_study.c',
    'pcre2/src/pcre2_substitute.c',
    'pcre2/src/pcre2_substring.c',
    'pcre2/src/pcre2_tables.c',
    'pcre2/src/pcre2_ucd.c',
    'pcre2/src/pcre2_valid_utf.c',
    'pcre2/src/pcre2_xclass.c'
  ]
  rvalue[binary.compiler.target.arch] = builder.Add(binary)

rvalue['header'] = pcre2_generated['pcre2_header']
